<Window x:Class="Daydreamer.App.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="84" Click="Ok_Click"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
