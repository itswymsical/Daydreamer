<Application x:Class="Daydreamer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ThemeManager swaps the first two entries between their Light and Dark versions. -->
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] Windows 11 look for the built-in controls (ships with .NET 9+). -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
                <!-- [1] Daydreamer's colors. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- [2] Daydreamer's control styles (they read colors from [1]). -->
                <ResourceDictionary Source="Themes/Daydreamer.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
