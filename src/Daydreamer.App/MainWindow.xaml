<Window x:Class="Daydreamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:app="clr-namespace:Daydreamer.App"
        xmlns:ambient="clr-namespace:Daydreamer.App.Ambient"
        xmlns:controls="clr-namespace:Daydreamer.App.Controls"
        xmlns:models="clr-namespace:Daydreamer.Core.Models;assembly=Daydreamer.Core"
        Title="Daydreamer" Icon="Daydreamer.ico" Width="1440" Height="900" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown" Closing="Window_Closing" SizeChanged="Window_SizeChanged">

    <!-- Our own title bar: the top 52px drag the window, double-click maximizes, edges resize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <app:HexToBrushConverter x:Key="HexToBrush" />
        <app:ReadableBrushConverter x:Key="ReadableBrush" />
        <app:FontNameConverter x:Key="FontName" />
        <app:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <app:InverseBoolConverter x:Key="InverseBool" />
        <app:AlignmentIconConverter x:Key="AlignmentIcon" />
        <app:ElementTypeNameConverter x:Key="ElementTypeName" />
        <app:LineCountConverter x:Key="LineCount" />
        <app:EditedDateConverter x:Key="EditedDate" />
        <app:PinLabelConverter x:Key="PinLabel" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- Toolbar button labels hide on narrow windows, leaving just the icons (see Window_SizeChanged). -->
        <Visibility x:Key="ToolbarLabelVisibility">Visible</Visibility>

        <!-- A list without its own scroll bar, for lists that sit inside a scrolling panel. -->
        <Style x:Key="StaticList" TargetType="ListBox" BasedOn="{StaticResource SoftList}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Visibility" Value="{DynamicResource ToolbarLabelVisibility}" />
        </Style>

        <Style x:Key="GuideKey" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,8,0,1" />
        </Style>

        <!-- A document on the Home page or a project's page: a picture of its first page, and its name. -->
        <DataTemplate x:Key="DocumentCard">
            <Button Style="{StaticResource HomeCard}" Width="214" Tag="{Binding}" Click="RecentDocument_Click"
                    AutomationProperties.Name="{Binding Title}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinLabel}}" Click="TogglePin_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Grid>
                        <Border Height="252" Background="{DynamicResource PageBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                            <controls:DocumentPreview Text="{Binding Preview}" Styles="{Binding Styles}" Characters="{Binding Characters}"
                                                      Keywords="{Binding Keywords}" CustomStyles="{Binding CustomStyles}" DialogueMarkup="{Binding DialogueMarkup}" />
                        </Border>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="13" Margin="0,9,9,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisible}}" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Margin="2,10,2,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="2,2,2,0" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ProjectName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding EditedText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A project on the Home page: its latest document as a cover, and how much is in it. Click for its page. -->
        <DataTemplate x:Key="ProjectCardTemplate">
            <Button Style="{StaticResource HomeCard}" Width="214" Tag="{Binding}" Click="ProjectCard_Click"
                    AutomationProperties.Name="{Binding Name}" ToolTip="See everything in this project">
                <StackPanel>
                    <Grid>
                        <Border Height="120" Background="{DynamicResource PageBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                            <controls:DocumentPreview Text="{Binding Latest.Preview}" Styles="{Binding Latest.Styles}" Characters="{Binding Latest.Characters}"
                                                      Keywords="{Binding Latest.Keywords}" CustomStyles="{Binding Latest.CustomStyles}" DialogueMarkup="{Binding Latest.DialogueMarkup}" />
                        </Border>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{DynamicResource ToolbarBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Margin="2,10,2,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Margin="2,2,2,0" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="CardRows">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- When maximized, Windows pushes the window edges slightly off-screen; this border's margin makes up for it. -->
    <Border x:Name="WindowRoot">
        <DockPanel>
            <!-- ═══════════════ Title bar ═══════════════ -->
            <Grid DockPanel.Dock="Top" Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The logo doubles as the Home button, like Google Docs. -->
                <Button x:Name="HomeButton" Style="{StaticResource FlatButton}" Margin="10,0,0,0" Padding="4" Click="Home_Click"
                        ToolTip="Home" AutomationProperties.Name="Home" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="32" Height="32" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#9775FA" Offset="0" />
                                <GradientStop Color="#5C7CFA" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Button>

                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="TitleBox" Style="{StaticResource TitleBox}" HorizontalAlignment="Left" MinWidth="220"
                             FontSize="16" WindowChrome.IsHitTestVisibleInChrome="True"
                             ToolTip="Rename this document" KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostFocus" />
                    <TextBlock x:Name="ProjectLabel" Margin="7,0,0,0" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left"
                               Cursor="Hand" ToolTip="See everything in this project" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="ProjectLabel_Click" />
                    <TextBlock x:Name="HomeTitle" Text="Daydreamer" FontSize="16" FontWeight="SemiBold" Margin="6,0,0,0" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="SaveIcon" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="SaveStatus" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" />
                    <!-- Save a copy as a PDF, Word file or plain text (MainWindow.Export.cs). -->
                    <Button x:Name="ExportButton" Style="{StaticResource FlatButton}" Margin="14,0,0,0" Click="ExportButton_Click"
                            ToolTip="Export as a PDF, Word document or plain text" IsEnabled="False"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Export">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconExport}" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="Export" FontSize="12.5" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- The music player, small: what's playing and its buttons (MainWindow.Music.cs). Click the song for the Music tab. -->
                    <Border x:Name="MiniPlayer" Background="{DynamicResource ToolbarBrush}" CornerRadius="16" Padding="3,0"
                            Margin="0,0,8,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Click="ShowMusic_Click" Padding="8,4"
                                    ToolTip="Open the Music tab" WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" FontSize="13" Margin="0,0,8,0"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="MiniTitle" FontSize="12.5" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="PreviousSong_Click" Padding="7,4" ToolTip="Previous"
                                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Previous song">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE892;" FontSize="11" />
                            </Button>
                            <Button x:Name="MiniPlayPause" Style="{StaticResource FlatButton}" Click="PlayPause_Click" Padding="7,4"
                                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Play or pause">
                                <TextBlock x:Name="MiniPlayPauseIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="NextSong_Click" Padding="7,4" ToolTip="Next"
                                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Next song">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="MusicButton" Style="{StaticResource FlatButton}" Click="ShowMusic_Click" ToolTip="Music"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Music">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" />
                    </Button>
                    <!-- Focus mode: just the page (MainWindow.Layout.cs). -->
                    <ToggleButton x:Name="FocusButton" Style="{StaticResource FlatButton}"
                                  Checked="FocusButton_Checked" Unchecked="FocusButton_Checked"
                                  WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Focus mode">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFocus}" />
                    </ToggleButton>
                    <Button x:Name="AmbientButton" Style="{StaticResource FlatButton}" Click="AmbientToggle_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="AmbientIcon" Style="{StaticResource Icon}" />
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource FlatButton}" Click="ThemeToggle_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="Maximize_Click" AutomationProperties.Name="Maximize" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
                </StackPanel>
            </Grid>

            <!-- Below the title bar: either the writing view or the Home page (MainWindow.Home.cs switches them). -->
            <Grid>
            <DockPanel x:Name="WritingView">
            <!-- ═══════════════ Toolbar ═══════════════ -->
            <!-- A WrapPanel, so on a narrow window the toolbar flows onto a second row instead of being cut off. -->
            <Border x:Name="Toolbar" DockPanel.Dock="Top" Margin="12,0,12,10" Padding="8,3" Background="{DynamicResource ToolbarBrush}" CornerRadius="18">
                <WrapPanel>
                    <Button Style="{StaticResource FlatButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- What kind of line this is; pick another to change it (like Google Docs' "Normal text ▾"). -->
                    <Button x:Name="TypeButton" Style="{StaticResource FlatButton}" Click="TypeButton_Click" AutomationProperties.Name="Kind of line" Margin="0,0,4,0"
                            ToolTip="What kind of line this is. Pick another kind to change the selected lines.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TypeLabel" Text="Description" MinWidth="78" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Font, size, color, spacing and alignment for the kind of line the cursor is on (DataContext: FormatTarget). -->
                    <StackPanel x:Name="FormatControls" Orientation="Horizontal">
                        <Button x:Name="FormatChip" Style="{StaticResource ChipButton}" Click="FormatChip_Click"
                                ToolTip="{Binding ToolTip}" IsEnabled="{Binding IsEnabled}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <ComboBox x:Name="ToolbarFont" Width="170" Margin="6,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Font" IsEnabled="{Binding IsEnabled}" IsTextSearchEnabled="True"
                                  ItemsSource="{x:Static controls:FontList.Names}" SelectedItem="{Binding FontFamily}"
                                  DropDownClosed="ToolbarCombo_DropDownClosed">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding Converter={StaticResource FontName}}" FontSize="14" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox x:Name="ToolbarSize" Width="72" Margin="4,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Size (pt)" IsEnabled="{Binding IsEnabled}" IsEditable="True"
                                  ItemsSource="{x:Static controls:FontList.Sizes}"
                                  Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                  DropDownClosed="ToolbarCombo_DropDownClosed" KeyDown="ToolbarSize_KeyDown" />

                        <Grid Margin="2,0,0,0">
                            <!-- Clicking the button while its pop-up is open should just close it, hence IsHitTestVisible. -->
                            <ToggleButton x:Name="ColorButton" Style="{StaticResource FlatButton}" ToolTip="Text color (optional)"
                                          IsEnabled="{Binding IsEnabled}"
                                          IsChecked="{Binding IsOpen, ElementName=ColorPopup}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=ColorPopup, Converter={StaticResource InverseBool}}">
                                <Grid Width="18" Height="20">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D3;" FontSize="14"
                                               VerticalAlignment="Top" HorizontalAlignment="Center" />
                                    <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Fill="{Binding EffectiveBrush}" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource PopupCard}" Width="276">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}">
                                            <Run Text="TEXT COLOR  ·  " /><Run Text="{Binding Label, Mode=OneWay}" />
                                        </TextBlock>
                                        <controls:ColorPicker SelectedColor="{Binding Color}" Picked="ColorPicker_Picked" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="Optional. Default keeps the text in the theme's gray, readable in light and dark mode." />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button x:Name="LineSpacingButton" Style="{StaticResource FlatButton}" Margin="2,0,0,0"
                                ToolTip="Line and paragraph spacing" IsEnabled="{Binding IsEnabled}" Click="LineSpacingButton_Click">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLineSpacing}" />
                        </Button>
                    </StackPanel>

                    <!-- These edit the text itself: emphasis, alignment, lists, indents. -->
                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource FlatButton}" Click="Bold_Click" ToolTip="Bold (Ctrl+B)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DD;" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Italic_Click" ToolTip="Italic (Ctrl+I)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DB;" />
                    </Button>
                    <!-- Aligns the line the cursor is on (or the selected lines), like Google Docs. -->
                    <Button x:Name="AlignButton" Style="{StaticResource FlatButton}" Click="AlignButton_Click"
                            ToolTip="Align this line (Ctrl+Shift+L, E, R or J)">
                        <Path x:Name="AlignIcon" Style="{StaticResource IconPath}" Data="{StaticResource IconAlignLeft}" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="BulletList_Click" ToolTip="Bulleted list (lines starting with - )">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBulletList}" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="NumberedList_Click" ToolTip="Numbered list (1. 2. 3.)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNumberList}" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Checklist_Click" ToolTip="Checklist ([ ] and [x] — click a box to tick it)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChecklist}" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Outdent_Click" ToolTip="Decrease indent (Shift+Tab on a list item)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconOutdent}" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Indent_Click" ToolTip="Increase indent (Tab on a list item)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconIndent}" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="ClearFormatting_Click" ToolTip="Clear formatting — removes bold and italic from the selected text">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClearFormatting}" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />

                    <TextBlock Text="Insert" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" Visibility="{DynamicResource ToolbarLabelVisibility}" />
                    <Button x:Name="InsertPageButton" Style="{StaticResource FlatButton}" Click="InsertPage_Click" ToolTip="New page (numbered automatically)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" />
                            <TextBlock x:Name="InsertPageLabel" Style="{StaticResource ToolbarLabel}" Text="Page" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="InsertPanelButton" Style="{StaticResource FlatButton}" Click="InsertPanel_Click" ToolTip="New panel (numbered automatically)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" />
                            <TextBlock x:Name="InsertPanelLabel" Style="{StaticResource ToolbarLabel}" Text="Panel" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertDialogue_Click" ToolTip="Pick a character and start their line">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" />
                            <TextBlock Style="{StaticResource ToolbarLabel}" Text="Dialogue" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertCaption_Click" ToolTip="Caption / narration box">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" />
                            <TextBlock x:Name="InsertCaptionLabel" Style="{StaticResource ToolbarLabel}" Text="Caption" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertSfx_Click" ToolTip="Sound effect">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" />
                            <TextBlock x:Name="InsertSfxLabel" Style="{StaticResource ToolbarLabel}" Text="SFX" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertNote_Click" ToolTip="A note to yourself">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70B;" />
                            <TextBlock x:Name="InsertNoteLabel" Style="{StaticResource ToolbarLabel}" Text="Note" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource FlatButton}" Click="Find_Click" ToolTip="Find (Ctrl+F)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                    </Button>
                    <!-- Tucks the side panel (Characters, Styles, Music, Guide) away to give the page more room. -->
                    <Button x:Name="SidePanelButton" Style="{StaticResource FlatButton}" Click="SidePanelToggle_Click"
                            AutomationProperties.Name="Show or hide the side panel">
                        <Path x:Name="SidePanelIcon" Style="{StaticResource IconPath}" Data="{StaticResource IconSidePanel}" />
                    </Button>
                </WrapPanel>
            </Border>

            <!-- ═══════════════ Status bar ═══════════════ -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                <DockPanel>
                    <TextBlock x:Name="CaretInfo" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    <!-- "3 spelling mistakes": click to go to the next one (MainWindow.Spelling.cs). -->
                    <Button x:Name="SpellingStatus" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="0,-2,18,-2"
                            Padding="7,1" MinHeight="0" Visibility="Collapsed" Click="SpellingStatus_Click"
                            ToolTip="Go to the next spelling mistake (right-click it for fixes)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,3 L1.5,1 L3,3 L4.5,1 L6,3 L7.5,1 L9,3" Stroke="{DynamicResource SpellingBrush}" StrokeThickness="1.2"
                                  VerticalAlignment="Center" Margin="0,2,6,0" />
                            <TextBlock x:Name="SpellingStatusText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatsText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
            </Border>

            <!-- ═══════════════ Main area ═══════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="250" MinWidth="180" />
                    <ColumnDefinition x:Name="LeftSplitterColumn" Width="6" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                    <ColumnDefinition x:Name="RightSplitterColumn" Width="6" />
                    <ColumnDefinition x:Name="RightColumn" Width="350" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- ─── Left: projects and documents ─── -->
                <DockPanel x:Name="ProjectPanel" Margin="12,0,0,12">
                    <DockPanel DockPanel.Dock="Top" Margin="4,4,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="NewProject_Click" ToolTip="New project" MinHeight="26" Padding="6,3">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                        </Button>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="PROJECT" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <ComboBox x:Name="ProjectPicker" DockPanel.Dock="Top" SelectionChanged="ProjectPicker_SelectionChanged"
                              HorizontalAlignment="Stretch" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource FlatButton}" Click="RenameProject_Click" ToolTip="Rename project" Padding="8,3" MinHeight="26">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" FontSize="12" Margin="0,0,5,0" />
                                <TextBlock Text="Rename" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Click="OpenProjectFolder_Click" ToolTip="Show the project's files in Explorer" Padding="8,3" MinHeight="26">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,5,0" />
                                <TextBlock Text="Files" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="4,18,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="NewDocument_Click" ToolTip="New document (Ctrl+N)" MinHeight="26" Padding="6,3">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Import_Click" MinHeight="26" Padding="6,3"
                                ToolTip="Import a Word or Google Docs file (.docx), or a text file">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconImport}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="DOCUMENTS" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox x:Name="DocumentList" Style="{StaticResource SoftList}" SelectionChanged="DocumentList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Background="Transparent">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinLabel}}" Click="TogglePin_Click" />
                                            <MenuItem Header="Rename" Click="RenameDocumentMenu_Click" />
                                            <!-- Its formats are added as it opens (MainWindow.Export.cs); the empty item gives it its ▸ arrow. -->
                                            <MenuItem Header="Export" SubmenuOpened="ExportSubmenu_Opened">
                                                <MenuItem />
                                            </MenuItem>
                                            <MenuItem Header="Move to trash" Click="TrashDocumentMenu_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="11" Margin="7,1,0,0" ToolTip="Pinned"
                                                   Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Modified, Converter={StaticResource EditedDate}}" FontSize="11"
                                               Margin="21,1,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter x:Name="LeftSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ─── Center: the page ─── -->
                <Border Grid.Column="2" Background="{DynamicResource CanvasBrush}" CornerRadius="12,12,0,0" ClipToBounds="True">
                    <Grid x:Name="EditorHost" SizeChanged="EditorHost_SizeChanged">
                        <Border x:Name="Paper" Background="{DynamicResource PageBrush}" HorizontalAlignment="Left"
                                Margin="0,18,0,0" CornerRadius="4,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="PaperShadow" BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.10" />
                            </Border.Effect>
                        </Border>

                        <!-- Ambient mode: soft lights drifting up over the page, underneath the words. -->
                        <ambient:AmbientField x:Name="AmbientLights" />

                        <avalon:TextEditor x:Name="Editor" Background="Transparent" WordWrap="True" ShowLineNumbers="False"
                                           HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                           FontFamily="Segoe UI" FontSize="16" />

                        <!-- A suggestion that floats over the top of the page, e.g. "use this line spacing?". -->
                        <Border x:Name="InfoBar" Style="{StaticResource PopupCard}" VerticalAlignment="Top" HorizontalAlignment="Center"
                                Margin="0,30,0,0" Padding="14,8,8,8" MaxWidth="560" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="InfoBarClose_Click" ToolTip="Dismiss" Padding="6,4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                </Button>
                                <Button x:Name="InfoBarAction" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="10,0,4,0"
                                        Padding="12,4" Click="InfoBarAction_Click" />
                                <TextBlock x:Name="InfoBarText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                            </DockPanel>
                        </Border>

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource IconBadgeBrush}" />
                            <TextBlock Text="No document open" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                            <TextBlock Text="Create one to start writing." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource AccentButton}" Content="New document" Margin="0,14,0,0" Padding="16,7"
                                    HorizontalAlignment="Center" Click="NewDocument_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter x:Name="RightSplitter" Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ─── Right: the formatting tool ─── -->
                <Border x:Name="FormattingPanel" Grid.Column="4" Margin="0,0,12,12" Background="{DynamicResource PaperBrush}"
                        CornerRadius="12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <TabControl x:Name="FormattingTabs" Style="{StaticResource PanelTabs}">

                        <!-- Characters -->
                        <TabItem x:Name="CharactersTab" Header="Characters">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="16,12,16,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="AddCharacter_Click" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="Add" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Text="Lines starting with a character's name in capitals use their style." />
                                </DockPanel>

                                <ListBox x:Name="CharacterList" Grid.Row="1" Margin="10,4,10,0" MaxHeight="230"
                                         Style="{StaticResource SoftList}" ItemsSource="{Binding Characters}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <!-- Gray unless the character has a name color. -->
                                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{Binding NameColor, Converter={StaticResource ReadableBrush}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NameColor}" Value="{x:Null}">
                                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="{Binding LineCount, Converter={StaticResource LineCount}}" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{Binding Style.FontFamily, Converter={StaticResource FontName}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding NameColor, Converter={StaticResource ReadableBrush}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NameColor}" Value="{x:Null}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Names used in the script that aren't characters yet -->
                                <Border x:Name="UnknownSpeakersPanel" Grid.Row="2" Margin="16,10,16,0" Padding="12,10"
                                        Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button x:Name="AddAllSpeakersButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                                    Padding="8,2" MinHeight="22" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                                    Foreground="{DynamicResource WarningTextBrush}" Click="AddAllSpeakers_Click"
                                                    ToolTip="Add every name here as a character" Content="Add all" />
                                            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center"
                                                       Text="These look like speakers in this document. Add them as characters so their lines are formatted:" />
                                        </DockPanel>
                                        <ItemsControl x:Name="UnknownSpeakersList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FlatButton}" Background="{DynamicResource WarningChipBrush}" Margin="0,0,6,4"
                                                            Padding="8,3" MinHeight="24" Tag="{Binding}" Click="AddUnknownSpeaker_Click"
                                                            ToolTip="Add as a character">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="10" Margin="0,0,5,0"
                                                                       Foreground="{DynamicResource WarningTextBrush}" />
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource WarningTextBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="3" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="16,12" TextAlignment="Center"
                                                   Visibility="{Binding SelectedItem, ElementName=CharacterList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}"
                                                   Text="Select a character to change how their lines look." />

                                        <StackPanel Margin="16,0,16,16" DataContext="{Binding SelectedItem, ElementName=CharacterList}"
                                                    Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,6" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name (as you type it in the script)" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontWeight="SemiBold" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Also recognise these names (comma-separated)" />
                                            <TextBox Text="{Binding Aliases, UpdateSourceTrigger=PropertyChanged, Delay=300}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name tag color (optional)" />
                                            <controls:ColorPicker SelectedColor="{Binding NameColor}" />

                                            <TextBlock Style="{StaticResource SectionHeader}" Text="THEIR LINES" Margin="0,18,0,0" />
                                            <controls:StyleEditor DataContext="{Binding Style}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" Margin="0,16,0,4" />
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />

                                            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                                    Click="DeleteCharacter_Click" Foreground="{DynamicResource DangerTextBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="Remove character" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- Styles -->
                        <TabItem x:Name="StylesTab" Header="Styles">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,12,10,16">
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,6,8"
                                               Text="How each kind of line looks. Change a style once and the whole script follows." />

                                    <ListBox x:Name="StylesList" Style="{StaticResource StaticList}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Width="92" Text="{Binding Name}" FontSize="12.5"
                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Example}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               FontFamily="{Binding PreviewFont}" FontSize="{Binding PreviewSize}"
                                                               FontWeight="{Binding PreviewWeight}" FontStyle="{Binding PreviewStyle}"
                                                               Foreground="{Binding PreviewBrush}" TextDecorations="{Binding PreviewDecorations}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Margin="6,6,6,0" DataContext="{Binding SelectedItem, ElementName=StylesList}"
                                                Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,10" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" Margin="0,2,0,0" />
                                        <controls:StyleEditor DataContext="{Binding Style}" />
                                    </StackPanel>

                                    <!-- Styles you make yourself, for one document or a whole project (MainWindow.Styles.cs). -->
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,20,6,12" />
                                    <DockPanel Margin="6,0,6,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="AddStyle_Click" Padding="10,4" AutomationProperties.Name="New style">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Style" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="YOUR STYLES" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,4,6,6"
                                               Text="Your own looks for special lines, like a letter or an inscription. Make one for this document or the whole project, then put lines in it from the line menu at the left of the toolbar." />

                                    <ListBox x:Name="CustomStylesList" Style="{StaticResource StaticList}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Scope}" FontSize="11" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Example}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               FontFamily="{Binding PreviewFont}" FontSize="{Binding PreviewSize}"
                                                               FontWeight="{Binding PreviewWeight}" FontStyle="{Binding PreviewStyle}"
                                                               Foreground="{Binding PreviewBrush}" TextDecorations="{Binding PreviewDecorations}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Margin="6,6,6,0" DataContext="{Binding SelectedItem, ElementName=CustomStylesList}"
                                                Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,10" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" Margin="0,2,0,0" />
                                        <controls:StyleEditor DataContext="{Binding Style}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Style="{StaticResource FlatButton}" Click="RenameCustomStyle_Click" Content="Rename" />
                                            <Button Style="{StaticResource FlatButton}" Click="MoveCustomStyle_Click" Content="{Binding MoveLabel}" />
                                            <Button Style="{StaticResource FlatButton}" Click="DeleteCustomStyle_Click" Foreground="{DynamicResource DangerTextBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="Remove style" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- The words that start special lines, renamable per project (SCENE instead of PANEL...) -->
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,20,6,12" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="KEYWORDS" Margin="6,0,6,0" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,4,6,8"
                                               Text="The words that start special lines. Rename them to fit how you write — SCENE instead of PANEL, say. The usual words keep working too." />
                                    <Grid Margin="6,0,6,0" DataContext="{Binding Keywords}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock" x:Key="KeywordLabel">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            </Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Margin" Value="0,2" />
                                                <Setter Property="CharacterCasing" Value="Upper" />
                                                <EventSetter Event="KeyDown" Handler="KeywordBox_KeyDown" />
                                            </Style>
                                        </Grid.Resources>
                                        <TextBlock Grid.Row="0" Style="{StaticResource KeywordLabel}" Text="Pages" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Page}" ToolTip="Starts a page: PAGE 1" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource KeywordLabel}" Text="Panels" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Panel}" ToolTip="Starts a panel: PANEL 1 (or SCENE 1, if you rename it)" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource KeywordLabel}" Text="Captions" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Caption}" ToolTip="Starts a caption: CAPTION: Tokyo, 2045." />
                                        <TextBlock Grid.Row="3" Style="{StaticResource KeywordLabel}" Text="Sound effects" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Sfx}" ToolTip="Starts a sound effect: SFX: KRAKOOM" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource KeywordLabel}" Text="Notes" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Note}" ToolTip="Starts a note to yourself: NOTE: check this" />
                                    </Grid>

                                    <!-- Modifier rules: (thought), (shout), ... -->
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,20,6,12" />
                                    <DockPanel Margin="6,0,6,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="AddModifier_Click" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Rule" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="DIALOGUE MODIFIERS" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,4,6,6"
                                               Text="A word in parentheses after a name, like AKIRA (thought):, adds this style on top of the character's." />

                                    <ListBox x:Name="ModifierList" Style="{StaticResource StaticList}" ItemsSource="{Binding Styles.Modifiers}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="13">
                                                    <Run Text="(" Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding Keyword}" /><Run Text=")" Foreground="{DynamicResource MutedTextBrush}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Margin="6,6,6,0" DataContext="{Binding SelectedItem, ElementName=ModifierList}"
                                                Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Word in parentheses" />
                                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                        <controls:StyleEditor DataContext="{Binding Style}" />
                                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                Click="DeleteModifier_Click" Foreground="{DynamicResource DangerTextBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Remove rule" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- What headings from Google Docs / Word become -->
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,20,6,12" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="IMPORTING &amp; PASTING" Margin="6,0,6,0" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,4,6,8"
                                               Text="What headings become when you paste from Google Docs or Word, or import a .docx file." />
                                    <Grid x:Name="HeadingMapGrid" Margin="6,0,6,0" DataContext="{Binding ImportHeadings}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock" x:Key="MapLabel">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            </Style>
                                            <DataTemplate x:Key="TypeName">
                                                <TextBlock Text="{Binding Converter={StaticResource ElementTypeName}}" />
                                            </DataTemplate>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Margin" Value="0,2" />
                                                <Setter Property="ItemsSource" Value="{x:Static models:HeadingMap.Choices}" />
                                                <Setter Property="ItemTemplate" Value="{StaticResource TypeName}" />
                                            </Style>
                                        </Grid.Resources>
                                        <TextBlock Grid.Row="0" Style="{StaticResource MapLabel}" Text="Title" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding Title}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource MapLabel}" Text="Heading 1" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Heading1}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource MapLabel}" Text="Heading 2" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Heading2}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource MapLabel}" Text="Heading 3" />
                                        <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Heading3}" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource MapLabel}" Text="Heading 4" />
                                        <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Heading4}" />
                                        <TextBlock Grid.Row="5" Style="{StaticResource MapLabel}" Text="Heading 5" />
                                        <ComboBox Grid.Row="5" Grid.Column="1" SelectedItem="{Binding Heading5}" />
                                        <TextBlock Grid.Row="6" Style="{StaticResource MapLabel}" Text="Heading 6" />
                                        <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Heading6}" />
                                    </Grid>

                                    <!-- Where this project's dialogue goes (MainWindow.Game.cs). -->
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,20,6,12" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="GAME DIALOGUE" Margin="6,0,6,0" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,4,6,8"
                                               Text="The mod this project's dialogue is sent to, with Export → Send to the game. Choosing one also hides pauses and effects on the page, except on the line you're editing. The Guide tab shows how to write it all." />
                                    <TextBlock x:Name="GameFolderLabel" Margin="6,0,6,6" FontSize="12" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="2,0,0,0" Click="ChooseGameFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Choose game folder…" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Music: songs, playlists and the player (MainWindow.Music.cs). It's the same for every project. -->
                        <TabItem x:Name="MusicTab" Header="Music">
                            <Grid>
                                <Grid.Resources>
                                    <!-- The sliders fill with Daydreamer's purple instead of the Windows accent color
                                         (these are the names WPF's Fluent theme looks the colors up by). -->
                                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource AccentColor}" />
                                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource AccentColor}" Opacity="0.9" />
                                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{DynamicResource AccentColor}" Opacity="0.8" />
                                    <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource AccentColor}" />
                                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource AccentColor}" />
                                </Grid.Resources>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Now playing -->
                                <Border Margin="12,12,12,0" Padding="14,12,14,8" CornerRadius="10" Background="{DynamicResource ToolbarBrush}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#9775FA" Offset="0" />
                                                        <GradientStop Color="#5C7CFA" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" FontSize="18" Foreground="White"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NowPlayingTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="NowPlayingArtist" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Click or drag to jump around in the song. -->
                                        <Slider x:Name="SeekBar" Margin="0,10,0,0" IsMoveToPointEnabled="True" Minimum="0" Maximum="1"
                                                AutomationProperties.Name="Position in the song"
                                                ValueChanged="SeekBar_ValueChanged"
                                                Thumb.DragStarted="SeekBar_DragStarted" Thumb.DragCompleted="SeekBar_DragCompleted" />
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock x:Name="DurationText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock x:Name="PositionText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                        </DockPanel>

                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button x:Name="MuteButton" Style="{StaticResource FlatButton}" Click="Mute_Click" Padding="6,4">
                                                    <TextBlock x:Name="VolumeIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="13" />
                                                </Button>
                                                <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                        SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                                                        AutomationProperties.Name="Volume" ValueChanged="VolumeSlider_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource FlatButton}" Click="PreviousSong_Click" ToolTip="Previous (or back to the start of this song)"
                                                        AutomationProperties.Name="Previous song">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE892;" FontSize="13" />
                                                </Button>
                                                <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButton}" Click="PlayPause_Click"
                                                        Width="40" Height="40" Padding="0" Margin="2,0" AutomationProperties.Name="Play or pause">
                                                    <TextBlock x:Name="PlayPauseIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="16" />
                                                </Button>
                                                <Button Style="{StaticResource FlatButton}" Click="NextSong_Click" ToolTip="Next" AutomationProperties.Name="Next song">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock x:Name="MusicProblem" Style="{StaticResource Hint}" Margin="0,6,0,2" Visibility="Collapsed"
                                                   Foreground="{DynamicResource WarningTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Playlists -->
                                <StackPanel Grid.Row="1" Margin="16,14,16,0">
                                    <DockPanel Margin="4,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="NewPlaylist_Click" ToolTip="New playlist"
                                                MinHeight="26" Padding="6,3">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                                        </Button>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="PLAYLIST" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ComboBox x:Name="PlaylistPicker" HorizontalAlignment="Stretch" SelectionChanged="PlaylistPicker_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button x:Name="RenamePlaylistButton" Style="{StaticResource FlatButton}" Click="RenamePlaylist_Click"
                                                ToolTip="Rename this playlist" Padding="8,3" MinHeight="26">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" FontSize="12" Margin="0,0,5,0" />
                                                <TextBlock Text="Rename" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DeletePlaylistButton" Style="{StaticResource FlatButton}" Click="DeletePlaylist_Click"
                                                ToolTip="Delete this playlist (its songs stay in All songs)" Padding="8,3" MinHeight="26">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,5,0" />
                                                <TextBlock Text="Delete" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource FlatButton}" Click="OpenMusicFolder_Click" Padding="8,3" MinHeight="26"
                                                ToolTip="Show the Music folder, where Daydreamer keeps its copies of your songs">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,5,0" />
                                                <TextBlock Text="Files" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Songs -->
                                <DockPanel Grid.Row="2" Margin="20,14,16,4">
                                    <Button x:Name="AddSongsButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="AddSongs_Click" Padding="10,4"
                                            ToolTip="Copy songs into Daydreamer's Music folder (MP3, M4A, WAV, WMA or FLAC). Or drag them here.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="Add songs" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="SongCount" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>

                                <Grid Grid.Row="3" Margin="10,0,10,10">
                                    <!-- Double-click a song to play the list from there; drag songs to reorder them, or drop files in from Explorer. -->
                                    <ListBox x:Name="SongList" Style="{StaticResource SoftList}" AllowDrop="True"
                                             MouseDoubleClick="SongList_MouseDoubleClick" KeyDown="SongList_KeyDown"
                                             PreviewMouseLeftButtonDown="SongList_PreviewMouseLeftButtonDown" PreviewMouseMove="SongList_PreviewMouseMove"
                                             DragOver="SongList_DragOver" Drop="SongList_Drop" ContextMenuOpening="SongList_ContextMenuOpening">
                                        <ListBox.ContextMenu>
                                            <ContextMenu />
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Background="Transparent">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" FontSize="11.5" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <!-- A speaker beside the song that's playing, a note beside the rest. -->
                                                    <TextBlock DockPanel.Dock="Left" Width="24" FontSize="12" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                <Setter Property="Text" Value="&#xEC4F;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE767;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Artist}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Visibility="{Binding Artist, Converter={StaticResource NullToCollapsed}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="SongsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0"
                                                IsHitTestVisible="False" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" FontSize="34" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource IconBadgeBrush}" />
                                        <TextBlock x:Name="SongsEmptyText" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,10,0,0"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Settings for how songs follow each other. -->
                                <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,8,16,10">
                                    <DockPanel>
                                        <ComboBox x:Name="CrossfadePicker" DockPanel.Dock="Right" Width="96" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Crossfade length" SelectionChanged="CrossfadePicker_SelectionChanged" />
                                        <TextBlock Text="Crossfade between songs" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   ToolTip="How long one song takes to fade into the next. Songs that cut in line fade in this way too." />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Guide -->
                        <TabItem Header="Guide">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,8,16,16">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4"
                                               Text="Write normally — Daydreamer recognises these patterns and formats them for you. Or set any line's kind yourself from the menu at the left of the toolbar (“Description ▾”); nothing extra appears in your text." />

                                    <TextBlock Style="{StaticResource GuideKey}" Text="AKIRA Hello.   AKIRA: Hello." />
                                    <TextBlock Style="{StaticResource Hint}" Text="Dialogue: a character's name in capitals, then their line — with or without a colon. In bold works too (**AKIRA** Hello.). Names that start lots of lines are suggested on the Characters tab, ready to add." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="AKIRA (thought) Hmm." />
                                    <TextBlock Style="{StaticResource Hint}" Text="A modifier. Rules in Styles → Dialogue modifiers apply on top." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="PAGE 1     PANEL 1" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Start a page or a panel; the toolbar numbers them for you. Rename the words in Styles → Keywords (SCENE 1, say)." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="CAPTION Tokyo, 2045." />
                                    <TextBlock Style="{StaticResource Hint}" Text="Narration box (with or without a colon, or numbered: CAPTION 2). CAPTION (AKIRA): uses AKIRA's font." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="SFX KRAKOOM" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Sound effect. FX works too." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="// note to self" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Not part of the script and not counted. NOTE: works too." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="# Chapter 1" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A heading. The # disappears once you leave the line." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="**bold**   *italic*" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Emphasis inside any line (Ctrl+B / Ctrl+I). The stars only show on the line you're editing." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="- item    1. item    [ ] task" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Bulleted, numbered and checklist lines. Enter continues a list; Tab and Shift+Tab nest it." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="Anything else" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Panel descriptions and prose." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="FORMATTING" Margin="0,22,0,2" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Put the cursor on a line and use the toolbar's font, size, color and spacing. The change applies to every line of that kind — every AKIRA line, every SFX line — so a script never needs formatting by hand. On an empty line, it changes Default text, which every kind of line starts from." />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="Alignment is different: like a word processor, it's just for the line you're on (or the lines you've selected). A line remembers its alignment, and the kind you picked from the menu, in a little tag at its start that stays hidden." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="SPELLING" Margin="0,22,0,2" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Misspelled words get a wavy red line; right-click one for fixes, or to add it to this story's dictionary. Only the words people read are checked: names, SFX and notes are left alone, and so are words in capitals. The status bar counts the mistakes, and clicking it goes to the next one. Turn checking off from the right-click menu." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="BRINGING TEXT IN" Margin="0,22,0,2" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Import a .docx (Word or Google Docs) or paste from them: headings become pages and panels (Styles → Importing), lists and emphasis come along, centered lines stay centered, and an imported document's font, size and spacing become your project's — with an Undo." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="GAME DIALOGUE" Margin="0,22,0,2" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="One document per character, with everything they'll ever say. Export → Send to the game writes their words into the mod's localization (HJSON) and their conversations into a definition (C#), each in the right place. Import a localization file to bring existing dialogue in." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="# Greeting" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A conversation. Silvian's document makes this Silvian.Greeting." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="SILVIAN: Well, howdy!" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A line. Without a name, it's the document's character, or whoever spoke last in this conversation." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="SILVIAN (slow, worried): Huh." />
                                    <TextBlock Style="{StaticResource Hint}" Text="A tone for the whole line: slow, fast, speed 0.8, emote 3, or one of your own." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="Well,[] howdy![30] Name's Silvian." />
                                    <TextBlock Style="{StaticResource Hint}" Text="Pauses. [] fits its punctuation, [30] waits 30 frames. They only show on the line you're editing." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="[shake 0.6: Don't.]  [up: really]" />
                                    <TextBlock Style="{StaticResource Hint}" Text="An effect on some words: shake, wave, slow, fast, pitch, up, down, question, emphasis, waver, inflect. Or select the words and right-click → Dialogue effect. [words] alone means emphasis." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="[player]" />
                                    <TextBlock Style="{StaticResource Hint}" Text="The player's name." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="- Finding my way. -> Lost" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A choice, and the conversation it leads to. Add (dead) for the answer that means no, or (run: Some.Code()) to run code." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="- Who's asking?&#x0a;      Just a neighbor." />
                                    <TextBlock Style="{StaticResource Hint}" Text="A response indented under its choice. It becomes a conversation of its own automatically." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="// unlock: HerbalForager" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Notes that do something, in a conversation: unlock: a job, handin: a job (under a line's two choices), complete: code to run at the end, hand-written (leave its flow to the mod's own code). Any other note becomes a comment." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="// speed: 1.1&#x0a;// tone worried: emote 3, speed 0.9" />
                                    <TextBlock Style="{StaticResource Hint}" Text="The character's profile, above the first heading: speed, tone, speaker: Goblin Tinkerer, key: Tinkerer, color: 255 110 80 (for a new character), using: Some.Namespace (for code), pauses: auto (a pause after every comma and sentence on lines without any)." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="SHORTCUTS" Margin="0,22,0,2" />
                                    <TextBlock Style="{StaticResource Hint}" LineHeight="21">
                                        <Bold>Type a name in CAPS</Bold> — pick the character from the pop-up<LineBreak />
                                        <Bold>Ctrl+Space</Bold> — show characters and elements<LineBreak />
                                        <Bold>Ctrl+B / Ctrl+I</Bold> — bold / italic<LineBreak />
                                        <Bold>Ctrl+Shift+L / E / R / J</Bold> — align left / center / right / justify<LineBreak />
                                        <Bold>Ctrl+N</Bold> — new document<LineBreak />
                                        <Bold>Ctrl+F</Bold> — find<LineBreak />
                                        <Bold>Ctrl+S</Bold> — save now (it also saves automatically)<LineBreak />
                                        <Bold>Ctrl+\</Bold> — hide or show this side panel<LineBreak />
                                        <Bold>F11</Bold> — focus mode: just the page (Esc to leave)
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
            </DockPanel>

            <!-- ═══════════════ Home ═══════════════ -->
            <ScrollViewer x:Name="HomeView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid>
                <StackPanel x:Name="HomeMain" MaxWidth="1190" Margin="40,10,40,40">
                    <TextBlock x:Name="HomeGreeting" FontSize="26" FontWeight="SemiBold" Text="Welcome back" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"
                               Text="Pick up where you left off, or start something new." />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="START SOMETHING NEW" Margin="0,28,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource HomeCard}" Width="214" Click="HomeNewDocument_Click">
                            <StackPanel>
                                <Border Height="120" Background="{DynamicResource PageBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="30" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="Blank document" FontWeight="SemiBold" FontSize="13.5" Margin="2,10,2,0" />
                                <TextBlock x:Name="NewDocumentHint" Margin="2,2,2,0" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HomeCard}" Width="214" Click="HomeNewProject_Click">
                            <StackPanel>
                                <Border Height="120" Background="{DynamicResource PageBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" FontSize="30" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="New project" FontWeight="SemiBold" FontSize="13.5" Margin="2,10,2,0" />
                                <TextBlock Text="A new story or series" Margin="2,2,2,0" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HomeCard}" Width="214" Click="Import_Click" AutomationProperties.Name="Import a document">
                            <StackPanel>
                                <Border Height="120" Background="{DynamicResource PageBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconImport}" Width="34" Height="34"
                                          Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" />
                                </Border>
                                <TextBlock Text="Import" FontWeight="SemiBold" FontSize="13.5" Margin="2,10,2,0" />
                                <TextBlock Text="From Word or Google Docs (.docx)" Margin="2,2,2,0" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="PROJECTS" Margin="0,22,0,10" />
                    <ItemsControl x:Name="ProjectList" ItemsPanel="{StaticResource CardRows}" ItemTemplate="{StaticResource ProjectCardTemplate}" />

                    <StackPanel x:Name="PinnedSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="PINNED" Margin="0,22,0,10" />
                        <ItemsControl x:Name="PinnedList" ItemsPanel="{StaticResource CardRows}" ItemTemplate="{StaticResource DocumentCard}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="RECENT DOCUMENTS" Margin="0,22,0,10" />
                    <TextBlock x:Name="NoRecent" Style="{StaticResource Hint}" FontSize="13" Visibility="Collapsed"
                               Text="Nothing here yet. Create a document to get started." />
                    <ItemsControl x:Name="RecentList" ItemsPanel="{StaticResource CardRows}" ItemTemplate="{StaticResource DocumentCard}" />
                </StackPanel>

                <!-- ─── One project's page: everything in it, without opening a document first ─── -->
                <StackPanel x:Name="ProjectPage" MaxWidth="1190" Margin="40,10,40,40" Visibility="Collapsed">
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="-8,0,0,6" Click="ProjectPageBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Home" />
                        </StackPanel>
                    </Button>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FlatButton}" Click="ProjectPageFiles_Click" ToolTip="Show the project's files in Explorer">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Files" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="ProjectPageImport_Click" Margin="4,0,0,0"
                                    ToolTip="Import a Word or Google Docs file (.docx), a text file, or game dialogue (.hjson)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconImport}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="Import" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Click="ProjectPageNewDocument_Click" Margin="8,0,0,0" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="New document" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="ProjectPageTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ProjectPageDetails" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel x:Name="ProjectPinnedSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="PINNED" Margin="0,28,0,10" />
                        <ItemsControl x:Name="ProjectPinnedList" ItemsPanel="{StaticResource CardRows}" ItemTemplate="{StaticResource DocumentCard}" />
                    </StackPanel>

                    <TextBlock x:Name="ProjectDocumentsHeader" Style="{StaticResource SectionHeader}" Text="DOCUMENTS" Margin="0,22,0,10" Visibility="Collapsed" />
                    <TextBlock x:Name="ProjectPageEmpty" Style="{StaticResource Hint}" FontSize="13" Margin="0,28,0,0" Visibility="Collapsed"
                               Text="Nothing here yet. Create a document to get started." />
                    <ItemsControl x:Name="ProjectDocumentList" Margin="0,18,0,0" ItemsPanel="{StaticResource CardRows}" ItemTemplate="{StaticResource DocumentCard}" />
                </StackPanel>
                </Grid>
            </ScrollViewer>
            </Grid>
