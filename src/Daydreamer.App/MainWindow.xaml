<Window x:Class="Daydreamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:app="clr-namespace:Daydreamer.App"
        xmlns:ambient="clr-namespace:Daydreamer.App.Ambient"
        xmlns:controls="clr-namespace:Daydreamer.App.Controls"
        Title="Daydreamer" Width="1440" Height="900" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" SizeChanged="Window_SizeChanged">

    <!-- Our own title bar: the top 52px drag the window, double-click maximizes, edges resize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <app:HexToBrushConverter x:Key="HexToBrush" />
        <app:ReadableBrushConverter x:Key="ReadableBrush" />
        <app:FontNameConverter x:Key="FontName" />
        <app:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <app:InverseBoolConverter x:Key="InverseBool" />
        <app:LineCountConverter x:Key="LineCount" />
        <app:EditedDateConverter x:Key="EditedDate" />

        <!-- Toolbar button labels hide on narrow windows, leaving just the icons (see Window_SizeChanged). -->
        <Visibility x:Key="ToolbarLabelVisibility">Visible</Visibility>

        <!-- A list without its own scroll bar, for lists that sit inside a scrolling panel. -->
        <Style x:Key="StaticList" TargetType="ListBox" BasedOn="{StaticResource SoftList}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Visibility" Value="{DynamicResource ToolbarLabelVisibility}" />
        </Style>

        <Style x:Key="GuideKey" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,8,0,1" />
        </Style>
    </Window.Resources>

    <!-- When maximized, Windows pushes the window edges slightly off-screen; this border's margin makes up for it. -->
    <Border x:Name="WindowRoot">
        <DockPanel>
            <!-- ═══════════════ Title bar ═══════════════ -->
            <Grid DockPanel.Dock="Top" Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="32" Height="32" CornerRadius="9" Margin="16,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#9775FA" Offset="0" />
                            <GradientStop Color="#5C7CFA" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="17" Foreground="White"
                               HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="TitleBox" Style="{StaticResource TitleBox}" HorizontalAlignment="Left" MinWidth="220"
                             FontSize="16" WindowChrome.IsHitTestVisibleInChrome="True"
                             ToolTip="Rename this document" KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostFocus" />
                    <TextBlock x:Name="ProjectLabel" Margin="7,0,0,0" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="SaveIcon" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="SaveStatus" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="AmbientButton" Style="{StaticResource FlatButton}" Click="AmbientToggle_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="AmbientIcon" Style="{StaticResource Icon}" />
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource FlatButton}" Click="ThemeToggle_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="Maximize_Click" AutomationProperties.Name="Maximize" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
                </StackPanel>
            </Grid>

            <!-- ═══════════════ Toolbar ═══════════════ -->
            <Border DockPanel.Dock="Top" Margin="12,0,12,10" Padding="8,3" Background="{DynamicResource ToolbarBrush}" CornerRadius="22">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- Font, size and color for the kind of line the cursor is on (DataContext: FormatTarget). -->
                    <StackPanel x:Name="FormatControls" Orientation="Horizontal">
                        <Button x:Name="FormatChip" Style="{StaticResource ChipButton}" Click="FormatChip_Click"
                                ToolTip="{Binding ToolTip}" IsEnabled="{Binding IsEnabled}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <ComboBox x:Name="ToolbarFont" Width="170" Margin="6,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Font" IsEnabled="{Binding IsEnabled}" IsTextSearchEnabled="True"
                                  ItemsSource="{x:Static controls:FontList.Names}" SelectedItem="{Binding FontFamily}"
                                  DropDownClosed="ToolbarCombo_DropDownClosed">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox x:Name="ToolbarSize" Width="72" Margin="4,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Size (pt)" IsEnabled="{Binding IsEnabled}" IsEditable="True"
                                  ItemsSource="{x:Static controls:FontList.Sizes}"
                                  Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                  DropDownClosed="ToolbarCombo_DropDownClosed" KeyDown="ToolbarSize_KeyDown" />

                        <Grid Margin="2,0,0,0">
                            <!-- Clicking the button while its pop-up is open should just close it, hence IsHitTestVisible. -->
                            <ToggleButton x:Name="ColorButton" Style="{StaticResource FlatButton}" ToolTip="Text color (optional)"
                                          IsEnabled="{Binding IsEnabled}"
                                          IsChecked="{Binding IsOpen, ElementName=ColorPopup}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=ColorPopup, Converter={StaticResource InverseBool}}">
                                <Grid Width="18" Height="20">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D3;" FontSize="14"
                                               VerticalAlignment="Top" HorizontalAlignment="Center" />
                                    <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Fill="{Binding EffectiveBrush}" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource PopupCard}" Width="276">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}">
                                            <Run Text="TEXT COLOR  ·  " /><Run Text="{Binding Label, Mode=OneWay}" />
                                        </TextBlock>
                                        <controls:ColorPicker SelectedColor="{Binding Color}" Picked="ColorPicker_Picked" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="Optional. Default keeps the text in the theme's gray, readable in light and dark mode." />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Line spacing: arrows between lines, drawn with a Path so it looks the same everywhere. -->
                        <Button x:Name="LineSpacingButton" Style="{StaticResource FlatButton}" Margin="2,0,0,0"
                                ToolTip="Line spacing" IsEnabled="{Binding IsEnabled}" Click="LineSpacingButton_Click">
                            <Path Width="16" Height="16" StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource TextBrush}"
                                  Data="M3.5,2.5 L3.5,13.5 M1.5,4.5 L3.5,2.5 L5.5,4.5 M1.5,11.5 L3.5,13.5 L5.5,11.5 M8,3.5 L15,3.5 M8,8 L15,8 M8,12.5 L15,12.5" />
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource FlatButton}" Click="Bold_Click" ToolTip="Bold (Ctrl+B) — wraps the selection in **stars**">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DD;" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Italic_Click" ToolTip="Italic (Ctrl+I) — wraps the selection in *stars*">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DB;" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />

                    <TextBlock Text="Insert" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" Visibility="{DynamicResource ToolbarLabelVisibility}" />
                    <Button Style="{StaticResource FlatButton}" Click="InsertPage_Click" ToolTip="New page (numbered automatically)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" />
                            <TextBlock Style="{StaticResource ToolbarLabel}" Text="Page" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertPanel_Click" ToolTip="New panel (numbered automatically)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" />
                            <TextBlock Style="{StaticResource ToolbarLabel}" Text="Panel" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertDialogue_Click" ToolTip="Pick a character and start their line">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" />
                            <TextBlock Style="{StaticResource ToolbarLabel}" Text="Dialogue" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertCaption_Click" ToolTip="Caption / narration box">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" />
                            <TextBlock Style="{StaticResource ToolbarLabel}" Text="Caption" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertSfx_Click" ToolTip="Sound effect">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" />
                            <TextBlock Style="{StaticResource ToolbarLabel}" Text="SFX" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="InsertNote_Click" ToolTip="A note to yourself">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70B;" />
                            <TextBlock Style="{StaticResource ToolbarLabel}" Text="Note" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource FlatButton}" Click="Find_Click" ToolTip="Find (Ctrl+F)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══════════════ Status bar ═══════════════ -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                <DockPanel>
                    <TextBlock x:Name="CaretInfo" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="StatsText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
            </Border>

            <!-- ═══════════════ Main area ═══════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="180" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="350" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- ─── Left: projects and documents ─── -->
                <DockPanel Margin="12,0,0,12">
                    <DockPanel DockPanel.Dock="Top" Margin="4,4,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="NewProject_Click" ToolTip="New project" MinHeight="26" Padding="6,3">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                        </Button>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="PROJECT" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <ComboBox x:Name="ProjectPicker" DockPanel.Dock="Top" SelectionChanged="ProjectPicker_SelectionChanged"
                              HorizontalAlignment="Stretch" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource FlatButton}" Click="RenameProject_Click" ToolTip="Rename project" Padding="8,3" MinHeight="26">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" FontSize="12" Margin="0,0,5,0" />
                                <TextBlock Text="Rename" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Click="OpenProjectFolder_Click" ToolTip="Show the project's files in Explorer" Padding="8,3" MinHeight="26">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,5,0" />
                                <TextBlock Text="Files" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="4,18,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="NewDocument_Click" ToolTip="New document (Ctrl+N)" MinHeight="26" Padding="6,3">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                        </Button>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="DOCUMENTS" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox x:Name="DocumentList" Style="{StaticResource SoftList}" SelectionChanged="DocumentList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Background="Transparent">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename" Click="RenameDocumentMenu_Click" />
                                            <MenuItem Header="Move to trash" Click="TrashDocumentMenu_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Modified, Converter={StaticResource EditedDate}}" FontSize="11"
                                               Margin="21,1,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ─── Center: the page ─── -->
                <Border Grid.Column="2" Background="{DynamicResource CanvasBrush}" CornerRadius="12,12,0,0" ClipToBounds="True">
                    <Grid x:Name="EditorHost" SizeChanged="EditorHost_SizeChanged">
                        <Border x:Name="Paper" Background="{DynamicResource PageBrush}" HorizontalAlignment="Left"
                                Margin="0,18,0,0" CornerRadius="4,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="PaperShadow" BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.10" />
                            </Border.Effect>
                        </Border>

                        <!-- Ambient mode: soft lights drifting up over the page, underneath the words. -->
                        <ambient:AmbientField x:Name="AmbientLights" />

                        <avalon:TextEditor x:Name="Editor" Background="Transparent" WordWrap="True" ShowLineNumbers="False"
                                           HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                           FontFamily="Segoe UI" FontSize="16" />

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource IconBadgeBrush}" />
                            <TextBlock Text="No document open" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                            <TextBlock Text="Create one to start writing." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource AccentButton}" Content="New document" Margin="0,14,0,0" Padding="16,7"
                                    HorizontalAlignment="Center" Click="NewDocument_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ─── Right: the formatting tool ─── -->
                <Border x:Name="FormattingPanel" Grid.Column="4" Margin="0,0,12,12" Background="{DynamicResource PaperBrush}"
                        CornerRadius="12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <TabControl x:Name="FormattingTabs" Style="{StaticResource PanelTabs}">

                        <!-- Characters -->
                        <TabItem Header="Characters">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="16,12,16,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="AddCharacter_Click" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="Add" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Text="Lines starting with a character's name and a colon use their style." />
                                </DockPanel>

                                <ListBox x:Name="CharacterList" Grid.Row="1" Margin="10,4,10,0" MaxHeight="230"
                                         Style="{StaticResource SoftList}" ItemsSource="{Binding Characters}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <!-- Gray unless the character has a name color. -->
                                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{Binding NameColor, Converter={StaticResource ReadableBrush}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NameColor}" Value="{x:Null}">
                                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="{Binding LineCount, Converter={StaticResource LineCount}}" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{Binding Style.FontFamily, Converter={StaticResource FontName}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding NameColor, Converter={StaticResource ReadableBrush}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NameColor}" Value="{x:Null}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Names used in the script that aren't characters yet -->
                                <Border x:Name="UnknownSpeakersPanel" Grid.Row="2" Margin="16,10,16,0" Padding="12,10"
                                        Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,6"
                                                   Text="Speakers in this document that aren't characters yet:" />
                                        <ItemsControl x:Name="UnknownSpeakersList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FlatButton}" Background="{DynamicResource WarningChipBrush}" Margin="0,0,6,4"
                                                            Padding="8,3" MinHeight="24" Tag="{Binding}" Click="AddUnknownSpeaker_Click"
                                                            ToolTip="Add as a character">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="10" Margin="0,0,5,0"
                                                                       Foreground="{DynamicResource WarningTextBrush}" />
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource WarningTextBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="3" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="16,12" TextAlignment="Center"
                                                   Visibility="{Binding SelectedItem, ElementName=CharacterList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}"
                                                   Text="Select a character to change how their lines look." />

                                        <StackPanel Margin="16,0,16,16" DataContext="{Binding SelectedItem, ElementName=CharacterList}"
                                                    Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,6" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name (as you type it in the script)" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontWeight="SemiBold" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Also recognise these names (comma-separated)" />
                                            <TextBox Text="{Binding Aliases, UpdateSourceTrigger=PropertyChanged, Delay=300}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name tag color (optional)" />
                                            <controls:ColorPicker SelectedColor="{Binding NameColor}" />

                                            <TextBlock Style="{StaticResource SectionHeader}" Text="THEIR LINES" Margin="0,18,0,0" />
                                            <controls:StyleEditor DataContext="{Binding Style}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" Margin="0,16,0,4" />
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />

                                            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                                    Click="DeleteCharacter_Click" Foreground="{DynamicResource DangerTextBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="Remove character" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- Styles -->
                        <TabItem Header="Styles">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,12,10,16">
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,6,8"
                                               Text="How each kind of line looks. Change a style once and the whole script follows." />

                                    <ListBox x:Name="StylesList" Style="{StaticResource StaticList}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Width="92" Text="{Binding Name}" FontSize="12.5"
                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Example}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               FontFamily="{Binding PreviewFont}" FontSize="{Binding PreviewSize}"
                                                               FontWeight="{Binding PreviewWeight}" FontStyle="{Binding PreviewStyle}"
                                                               Foreground="{Binding PreviewBrush}" TextDecorations="{Binding PreviewDecorations}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Margin="6,6,6,0" DataContext="{Binding SelectedItem, ElementName=StylesList}"
                                                Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,10" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" Margin="0,2,0,0" />
                                        <controls:StyleEditor DataContext="{Binding Style}" />
                                    </StackPanel>

                                    <!-- Modifier rules: (thought), (shout), ... -->
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,20,6,12" />
                                    <DockPanel Margin="6,0,6,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="AddModifier_Click" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Rule" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="DIALOGUE MODIFIERS" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,4,6,6"
                                               Text="A word in parentheses after a name, like AKIRA (thought):, adds this style on top of the character's." />

                                    <ListBox x:Name="ModifierList" Style="{StaticResource StaticList}" ItemsSource="{Binding Styles.Modifiers}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="13">
                                                    <Run Text="(" Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding Keyword}" /><Run Text=")" Foreground="{DynamicResource MutedTextBrush}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Margin="6,6,6,0" DataContext="{Binding SelectedItem, ElementName=ModifierList}"
                                                Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Word in parentheses" />
                                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                        <controls:StyleEditor DataContext="{Binding Style}" />
                                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                Click="DeleteModifier_Click" Foreground="{DynamicResource DangerTextBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Remove rule" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Guide -->
                        <TabItem Header="Guide">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,8,16,16">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4"
                                               Text="Write normally — Daydreamer recognises these patterns and formats them for you." />

                                    <TextBlock Style="{StaticResource GuideKey}" Text="# Chapter 1" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A chapter or scene heading." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="PAGE 1" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Starts a page. Toolbar → Page numbers it for you." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="PANEL 1" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Starts a panel. Numbering restarts on each page." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="AKIRA: Hello." />
                                    <TextBlock Style="{StaticResource Hint}" Text="Dialogue. Uses AKIRA's style if they're a character. Undefined names in CAPS get an orange dotted underline." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="AKIRA (thought): Hmm." />
                                    <TextBlock Style="{StaticResource Hint}" Text="A modifier. Rules in Styles → Dialogue modifiers apply on top." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="CAPTION: Tokyo, 2045." />
                                    <TextBlock Style="{StaticResource Hint}" Text="Narration box. CAPTION (AKIRA): uses AKIRA's font." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="SFX: KRAKOOM" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Sound effect. FX: works too." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="// note to self" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Not part of the script and not counted. NOTE: works too." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="**bold**   *italic*" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Emphasis inside any line." />
                                    <TextBlock Style="{StaticResource GuideKey}" Text="Anything else" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Panel descriptions and prose." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="FORMATTING" Margin="0,22,0,2" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Put the cursor on a line and use the toolbar's font, size, color and line spacing. The change applies to every line of that kind — every AKIRA line, every SFX line — so a script never needs formatting by hand. On an empty line, it changes Default text, which every kind of line starts from." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="SHORTCUTS" Margin="0,22,0,2" />
                                    <TextBlock Style="{StaticResource Hint}" LineHeight="21">
                                        <Bold>Type a name in CAPS</Bold> — pick the character from the pop-up<LineBreak />
                                        <Bold>Ctrl+Space</Bold> — show characters and elements<LineBreak />
                                        <Bold>Ctrl+B / Ctrl+I</Bold> — bold / italic<LineBreak />
                                        <Bold>Ctrl+N</Bold> — new document<LineBreak />
                                        <Bold>Ctrl+F</Bold> — find<LineBreak />
                                        <Bold>Ctrl+S</Bold> — save now (it also saves automatically)
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
