<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Daydreamer.Core\Daydreamer.Core.csproj" />
    <!-- The editor control, included as source with small paragraph-layout additions (see third-party/AvalonEdit). -->
    <ProjectReference Include="..\..\third-party\AvalonEdit\ICSharpCode.AvalonEdit\ICSharpCode.AvalonEdit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach internal helpers such as OrbSprites. -->
    <InternalsVisibleTo Include="Daydreamer.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The logo, as the .exe's icon (Explorer, Start, the taskbar). Made by tools/MakeIcon.ps1. -->
    <ApplicationIcon>Daydreamer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon for the window itself (taskbar button, Alt+Tab). -->
    <Resource Include="Daydreamer.ico" />
  </ItemGroup>

</Project>
