<!-- Dark mode colors. Same keys as Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="AccentColor">#9775FA</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#9775FA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C2547" />

    <SolidColorBrush x:Key="ChromeBrush" Color="#16161A" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#0E0E11" />
    <SolidColorBrush x:Key="PaperBrush" Color="#1E1E23" />
    <SolidColorBrush x:Key="PageBrush" Color="#1E1E23" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#222228" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2E2E36" />

    <SolidColorBrush x:Key="TextBrush" Color="#E6E6EA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9A9DA6" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2A32" />
    <SolidColorBrush x:Key="PressedBrush" Color="#34343D" />

    <SolidColorBrush x:Key="WarningBrush" Color="#FF922B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#2A1E12" />
    <SolidColorBrush x:Key="WarningChipBrush" Color="#3B2A17" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFB870" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8787" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="IconBadgeBrush" Color="#4C4860" />

    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#559775FA" />
    <SolidColorBrush x:Key="SearchMarkerBrush" Color="#55FFD43B" />
    <sys:Double x:Key="PageShadowOpacity">0.45</sys:Double>
</ResourceDictionary>
